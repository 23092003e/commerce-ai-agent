# Copy to .env.production; never commit the filled file.
# Run Compose with: --env-file .env.production -f docker-compose.production.yml
RELEASE_TAG=
PUBLIC_HOSTNAME=project.example.com
# Generate a random hexadecimal password (URL-safe), at least 32 characters.
POSTGRES_PASSWORD=
NODE_ENV=production
APP_BASE_URL=https://project.example.com
META_ADAPTER=graph
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v23.0
AI_PROVIDER=openrouter
AI_MODEL=
AI_API_KEY=
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
ADMIN_AUTH_SECRET=
METRICS_AUTH_SECRET=
LOG_LEVEL=info
HUMAN_REPLY_DELAY_ENABLED=true
