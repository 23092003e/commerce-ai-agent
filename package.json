{
  "name": "fanpage-sales-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @fanpage/db migrate",
    "dev": "pnpm --filter @fanpage/api dev",
    "fixture:send": "tsx --env-file=.env scripts/send-meta-fixture.ts",
    "seed:bakery-demo": "tsx --env-file=.env scripts/seed-bakery-demo.ts",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
